{
  "schemaVersion": 1,
  "mode": "active",
  "project": "obraxen",
  "limits": {
    "maxConcurrentWriters": 1,
    "maxPendingLocalDiffs": 1,
    "maxActiveSystemPullRequests": 1,
    "maxFindingsPerRun": 3,
    "maxChangedFiles": 8,
    "maxDiffLines": 400,
    "maxCorrectionIterations": 1,
    "maxRunSeconds": 1800,
    "leaseTtlSeconds": 2100
  },
  "memory": {
    "schemaVersion": 1,
    "maxEpisodicRuns": 120,
    "maxOpenFindings": 200,
    "maxProposedRules": 50,
    "contextRecentRuns": 8,
    "contextOpenFindings": 12,
    "maxContextBytes": 32768
  },
  "authority": {
    "allowScout": true,
    "allowMemoryPersistence": true,
    "allowLocalDiff": true,
    "allowCommit": false,
    "allowPush": false,
    "allowDraftPullRequest": false,
    "allowMerge": false,
    "allowDeploy": false,
    "allowPublish": false,
    "allowNetwork": false,
    "allowDependencyChanges": false
  },
  "protectedPaths": [
    ".codex/**",
    ".agents/**",
    "automation/agents/**",
    ".coordination/**",
    "AGENTS.md",
    "COORDINATION.md",
    "DECISIONS.md",
    "DEPLOYMENT_RUNBOOK.md",
    "LEGAL_CHECKLIST.md",
    "REPOSITORY_EXPOSURE.md",
    ".githooks/**",
    ".github/**",
    "vercel.json",
    ".env*",
    "package.json",
    "package-lock.json",
    "next.config.ts",
    "playwright.config.ts",
    "scripts/check-*",
    "scripts/lighthouse-budgets.ts",
    "scripts/qa-port.d.mts",
    "scripts/qa-port.mjs",
    "scripts/run-playwright.mjs",
    "CLAUDE.md",
    "ACTIVATION_GATE.md",
    "data/brand.json",
    "data/proyectos.json",
    "data/proyectos.borrador.json",
    "src/app/api/**",
    "src/app/qa/**",
    "src/app/robots.ts",
    "src/app/sitemap.ts",
    "src/components/consent-manager.tsx",
    "src/components/contact-form.tsx",
    "src/lib/analytics-config.ts",
    "src/lib/consent.ts",
    "src/lib/contact.ts",
    "src/lib/publication.ts",
    "src/lib/schemas.ts",
    "src/components/legal-page.tsx",
    "tests/activation-gate.test.ts"
  ],
  "activationInvariant": {
    "schemaVersion": 1,
    "candidateAuditRequired": true,
    "publicationAuthorized": false,
    "publishSwitch": false,
    "requireExactBeforeAfterMatch": true
  },
  "requiredChecks": [
    "npm run check:diff -- --base-sha <reviewed-base-sha> --head HEAD",
    "npm run check",
    "npm run check:quality",
    "npm run check:activation -- --json",
    "remote Quality gate for the exact reviewed SHA"
  ]
}
