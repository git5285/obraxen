# Ficheros que no hacen falta en el contexto de build de Vercel.
# src/, scripts/ y data/ son entradas de Next.js y no se excluyen. La salida
# desplegable la genera Vercel con su preset Next.js y nunca se sirve desde dist/.
*.md
.gitignore
.claude/
.coordination/
research/
data/proyectos.borrador.json
