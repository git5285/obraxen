{
  "name": "pavimentos-industriales-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "check:agent-runtime": "node automation/agents/runtime.mjs assert --json",
    "check:activation": "node --experimental-strip-types scripts/check-activation.mjs",
    "check:diff": "node scripts/check-branch-diff.mjs",
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:quality": "npm run check && npm run test:e2e:contact && npm run test:e2e && npm run lighthouse:ci",
    "dev": "next dev",
    "lighthouse:ci": "node scripts/check-lighthouse.mjs",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:contact": "node scripts/run-playwright.mjs --contact-enabled",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
