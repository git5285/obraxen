{
  "name": "pavimentos-industriales-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "check:agent-runtime": "node automation/agents/runtime.mjs exec -- node automation/agents/runtime.mjs assert --json",
    "check:activation": "node automation/agents/runtime.mjs exec -- node --experimental-strip-types scripts/check-activation.mjs",
    "check:diff": "node automation/agents/runtime.mjs exec -- node scripts/check-branch-diff.mjs",
    "build": "node automation/agents/runtime.mjs exec -- next build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:quality": "node automation/agents/runtime.mjs exec -- npm run check:security && node automation/agents/runtime.mjs exec -- node scripts/quality-gate.mjs",
    "check:security": "npm audit --omit=dev --audit-level=moderate --package-lock-only --ignore-scripts",
    "dev": "node automation/agents/runtime.mjs exec -- next dev",
    "lighthouse:ci": "node automation/agents/runtime.mjs exec -- node scripts/check-lighthouse.mjs",
    "lint": "node automation/agents/runtime.mjs exec -- eslint .",
    "start": "node automation/agents/runtime.mjs exec -- next start",
    "test": "node automation/agents/runtime.mjs exec -- vitest run",
    "test:coverage": "node automation/agents/runtime.mjs exec -- vitest run --coverage",
    "test:e2e": "node automation/agents/runtime.mjs exec -- node scripts/run-playwright.mjs",
    "test:e2e:contact": "node automation/agents/runtime.mjs exec -- node scripts/run-playwright.mjs --contact-enabled",
    "typecheck": "node automation/agents/runtime.mjs exec -- sh -c 'next typegen && tsc --noEmit'"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.4.1",
    "typescript": "6.0.3",
    "vercel": "59.16.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18"
  }
}
