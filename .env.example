# IDs públicos de medición, configurados por entorno en Vercel.
# El navegador solo los solicita al endpoint interno después de aceptar analítica.
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# Captación fail-closed mediante el plan gratuito de Resend. No activar hasta
# completar identidad, dominio verificado, DPA/subencargados y revisión legal.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
