{
  "description": "Deterministic least-authority guardrail for Obraxen custom agents.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-tool-policy.mjs",
            "timeout": 5,
            "statusMessage": "Comprobando la política de autonomía"
          }
        ]
      }
    ]
  }
}
