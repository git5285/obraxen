{
  "description": "Deterministic least-authority guardrail and repository-manifest dispatcher for Obraxen custom agents.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "IMPECCABLE_SKILL_DIR=\"$HOME/.agents/skills/impeccable\" \"$HOME/.agents/skills/impeccable/scripts/bin/darwin-arm64/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Revisando cambios de diseño"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "IMPECCABLE_SKILL_DIR=\"$HOME/.agents/skills/impeccable\" \"$HOME/.agents/skills/impeccable/scripts/bin/darwin-arm64/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Revisión final de diseño"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-tool-policy.mjs",
            "timeout": 5,
            "statusMessage": "Comprobando la política de autonomía"
          }
        ]
      }
    ]
  }
}
