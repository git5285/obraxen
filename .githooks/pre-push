#!/bin/sh

set -eu

zero_sha="0000000000000000000000000000000000000000"
run_quality=false
remote_name="${1:-origin}"
repository_root="$(git rev-parse --show-toplevel)"
base_ref="refs/remotes/${remote_name}/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_ref:-}" ]; then
    continue
  fi

  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push directo a main bloqueado: usa una rama y fusiona una PR con Quality gate verde." >&2
    exit 1
  fi

  case "$remote_ref" in
    refs/heads/*)
      if [ "$local_sha" != "$zero_sha" ]; then
        if ! git show-ref --verify --quiet "$base_ref"; then
          echo "No se puede verificar el diff: falta $base_ref." >&2
          exit 1
        fi
        cd "$repository_root"
        npm run check:diff -- --base-ref "$base_ref" --head "$local_sha"
        run_quality=true
      fi
      ;;
  esac
done

if [ "$run_quality" = true ]; then
  cd "$repository_root"
  echo "Ejecutando el gate local antes del push..."
  npm run check:quality
fi
